# ============================================================
# Marketing Automation — Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# These same values must be added as GitHub Secrets for the
# cron workflows to function.
# ============================================================

# Anthropic API key (for content generation with Claude)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Supabase (reuse your existing project credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Upload-Post API key (for publishing to social platforms)
# Sign up at: https://www.upload-post.com
# Get your key from the Upload-Post dashboard
UPLOAD_POST_API_KEY=xxxxx

# Upload-Post profile name (the profile you created in the dashboard)
UPLOAD_POST_PROFILE=purgatory-townhouse

# Brave Search API key (for web search — snow reports, events, conditions)
# Free tier: 2,000 queries/month
# Sign up at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=xxxxx

# Pexels API key (for royalty-free image search)
# Free tier: 200 requests/hour
# Sign up at: https://www.pexels.com/api/
PEXELS_API_KEY=xxxxx

# Telegram webhook secret (optional, for verifying webhook requests)
# Set this when configuring the bot webhook:
#   https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://yourdomain.com/api/telegram/webhook&secret_token=<SECRET>
TELEGRAM_WEBHOOK_SECRET=xxxxx
