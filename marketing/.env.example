# ============================================================
# Marketing Automation — Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# These same values must be added as GitHub Secrets for the
# cron workflows to function.
# ============================================================

# Anthropic API key (for content generation with Claude)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Supabase (reuse your existing project credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Ayrshare API key (for publishing to social platforms)
# Sign up at: https://www.ayrshare.com
# Get your key at: https://app.ayrshare.com/dashboard/api-key
AYRSHARE_API_KEY=xxxxx
